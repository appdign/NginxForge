# COMPLETE integrated site. No per-option includes or disabled security directives.
# DEPLOYMENT VALUES: replace domains, certificate paths, frontend root, fixed backend,
# administrator CIDRs, and the origins/CSP/cookie values in nginx.conf.
# Rename ONLY this file to site.conf after supplying real certificates.
# Install these default listeners once per address/port, even when adding more domains.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# Frontend: static site, HTTPS, security headers and diagnostic/file exposure guards.
server {
    listen 80;
    server_name example.test;
    return 308 https://example.test$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name example.test;
    ssl_certificate certs/example.test/fullchain.pem;
    ssl_certificate_key certs/example.test/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    root sites/example.test/public;
    if ($request_method !~ "^(GET|HEAD)$") { return 405; }
    location = /__nginxforge_error.html { internal; root html; }
    location ~ (^|/)\. { return 404; }
    location ~* ^/(conf|config|logs|temp|private|secrets|uploads|WEB-INF|META-INF)(/|$) { return 404; }
    location ~* \.(conf|config|ini|log|sql|bak|old|orig|save|swp|pem|key|pfx|p12|yaml|yml|env)$ { return 404; }
    location ~* \.(php|phtml|cgi|pl|py|jsp|jspx|asp|aspx|ashx|asmx|shtml|shtm|exe|dll|bat|cmd|ps1)(/|$) { return 404; }
    location ~* ^/(actuator|swagger-resources|v2/api-docs|v3/api-docs|h2-console)(/|$) { return 404; }
    location ~* ^/swagger-ui(\.html|/|$) { return 404; }
    location ~* \.map$ { return 404; }
    location / { try_files $uri $uri/ =404; }
}

# Spring Boot: fixed local backend, exact-origin CORS, private no-store and admin ACL.
server {
    listen 80;
    server_name app.example.test;
    return 308 https://app.example.test$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name app.example.test;
    ssl_certificate certs/app.example.test/fullchain.pem;
    ssl_certificate_key certs/app.example.test/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin $forge_cors_origin always;
    add_header Access-Control-Allow-Credentials $forge_cors_credentials always;
    add_header Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-TOKEN, X-XSRF-TOKEN" always;
    add_header Access-Control-Max-Age "600" always;
    add_header Vary "Origin" always;
    if ($forge_cors_reject_origin) { return 403; }
    if ($forge_cors_reject_method) { return 403; }
    if ($request_method !~ "^(GET|HEAD|POST|OPTIONS)$") { return 405; }
    if ($request_method = OPTIONS) { return 204; }
    location = /__nginxforge_error.html { internal; root html; }
    location ~ (^|/)\. { return 404; }
    location ~* ^/(conf|config|logs|temp|private|secrets|uploads|WEB-INF|META-INF)(/|$) { return 404; }
    location ~* \.(conf|config|ini|log|sql|bak|old|orig|save|swp|pem|key|pfx|p12|yaml|yml|env)$ { return 404; }
    location ~* \.(php|phtml|cgi|pl|py|jsp|jspx|asp|aspx|ashx|asmx|shtml|shtm|exe|dll|bat|cmd|ps1)(/|$) { return 404; }
    location ~* ^/(actuator|swagger-resources|v2/api-docs|v3/api-docs|h2-console)(/|$) { return 404; }
    location ~* ^/swagger-ui(\.html|/|$) { return 404; }
    location ~* \.map$ { return 404; }
    location ~ ^/(admin|api/admin)(/|$) {
        # DEPLOYMENT VALUE: add the actual management/VPN CIDRs before deny all.
        allow 127.0.0.1;
        allow ::1;
        deny all;
        # Keep Spring Boot authentication/authorization enabled behind this IP gate.
        proxy_pass http://127.0.0.1:9000;
    }
    location / {
        proxy_pass http://127.0.0.1:9000;
    }
}
