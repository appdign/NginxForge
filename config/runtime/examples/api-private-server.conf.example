# Optional PRIVATE API HTTPS SERVER context. Do not use for an entire public asset site.
# Review real session cookie names and SSO requirements. Never flag all cookies HttpOnly.
proxy_cookie_flags JSESSIONID secure httponly samesite=lax;
proxy_cookie_flags SESSION secure httponly samesite=lax;
# XSRF-TOKEN may need JavaScript access; it is deliberately not matched above.
# Cross-site SSO/API cookies may need SameSite=None + Secure after an app/CSRF review.
# This changes response flags, NOT session issuance, expiry, revocation or JWT validation.
proxy_cache off;
proxy_hide_header Cache-Control;
proxy_hide_header Expires;
add_header Cache-Control "no-store" always;
