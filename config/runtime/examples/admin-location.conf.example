# Location-context example: add INSIDE an HTTPS server and keep the application login enabled.
# No default username, password, or credential file is shipped.
location /admin/ {
    allow 127.0.0.1;
    allow ::1;
    # Add only the real management CIDRs, preferably through a VPN.
    deny all;
    # Optional extra gate, after creating a protected credential file outside every web root:
    # auth_basic "Restricted";
    # auth_basic_user_file conf/secrets/admin.htpasswd;
    proxy_pass http://127.0.0.1:9000;
}
