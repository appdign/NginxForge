# Optional HTTPS SERVER context. Include alongside response-headers.conf and HSTS.
# This self-only starting policy needs the real app's script/style/API/frame origins.
# Do not apply unchanged to apps needing inline scripts, external assets or SSO forms.
# For a trial, change ONLY the CSP header name to Content-Security-Policy-Report-Only.
# Nonces/hashes may require app/build cooperation; never use a fixed nonce.
proxy_hide_header Content-Security-Policy;
proxy_hide_header Content-Security-Policy-Report-Only;
proxy_hide_header Permissions-Policy;
add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
# Enable individual features only for origins that actually need them.
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
