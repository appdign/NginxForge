# 단일 도메인 SPA + API + storage + WebSocket 샘플.
# conf.d/site.conf로 복사하고 다른 사이트 샘플과 같은 domain/listen을 중복 활성화하지 않습니다.
# DEPLOYMENT VALUES: domain, 인증서, root, backend 주소, maps의 HTTPS origin, CSP WSS origin.
# Windows 예: root D:/apps/appdign/www; 인증서/키는 실제 절대 경로로 지정합니다.

# 아래 include는 http 문맥입니다. 반드시 server 블록 바깥에 둡니다.
include maps/spa-api-websocket.conf;
include policies/http/default-listeners.conf; # ON: 알 수 없는 Host/SNI 거부

server {
    listen 80;
    server_name example.test;
    include policies/server/https-redirect.conf; # ON: 고정 도메인의 HTTPS로 308
    location / { return 404; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.test;
    ssl_certificate certs/example.test/fullchain.pem;
    ssl_certificate_key certs/example.test/privkey.pem;
    root sites/example.test/public;

    # 공통 보안 스위치: 해당 include 앞에 #을 붙이면 OFF.
    # TLS는 nginx.conf의 policies/http/tls.conf에서 공통 관리합니다.
    include policies/server/identity.conf; # ON: 서버/제품 버전 숨김
    include policies/server/directory-listing.conf; # ON: 디렉터리 목록 OFF
    include policies/server/ssi.conf; # ON: SSI OFF
    include policies/server/compression.conf; # ON: 압축 OFF
    include policies/server/body-size.conf; # ON: 요청 본문 5 MiB, 실제 업로드 용량에 맞게 조정
    # 파일 서버: 위 5 MiB 줄을 주석 처리하고 아래 1 GiB 줄을 활성화합니다. 둘을 동시에 켜지 않습니다.
    # include policies/server/upload-body-size.conf; # OPTION: 전체 요청 1 GiB, 파일당 50 MiB는 backend 설정
    include policies/server/timeouts.conf; # ON: 클라이언트 시간/헤더 제한
    include policies/server/request-rate.conf; # ON: 요청 빈도 제한
    include policies/server/connection-limit.conf; # ON: 연결 제한, 장기 WebSocket/NAT 사용자 수 고려
    include policies/server/generic-errors.conf; # ON: 오류 가림, API 오류 JSON이 필요하면 앱 처리와 대조
    include policies/server/symlinks.conf; # ON: Linux 링크 차단 / Windows OS 점검
    include policies/server/nosniff.conf; # ON: MIME 추측 방지
    include policies/server/frame-options.conf; # ON: 프레임 제한
    include policies/server/referrer-policy.conf; # ON: Referrer 제한
    include policies/server/csp-spa.conf; # ON: 동일 origin + WSS CSP, 실제 앱/SSO 출처 확인
    include policies/server/permissions-policy.conf; # ON: 브라우저 기능 제한
    include policies/server/hsts.conf; # ON: HTTPS HSTS
    include policies/server/session-cookies.conf; # ON: 지정 세션 쿠키 플래그
    include policies/server/proxy-headers.conf; # ON: 전체 전달 헤더 재작성
    include policies/server/proxy-timeouts.conf; # ON: 일반 backend 시간 제한
    include policies/server/private-cache-spa.conf; # ON: API/오류만 no-store, 정적 정상 응답은 제외

    # Regex 보안 location은 유지합니다. 아래 proxy location에 ^~를 붙이면 이를 우회할 수 있습니다.
    include policies/server/secret-files.conf; # ON: 설정/키/백업/숨김 파일
    include policies/server/script-files.conf; # ON: 스크립트/실행 파일
    include policies/server/uploads.conf; # ON: 직접 uploads 접근
    include policies/server/management-paths.conf; # ON: 기본 관리/진단 경로
    include policies/server/sourcemaps.conf; # ON: 소스맵 공개

    # 같은 origin 구조라 NGINX CORS/preflight 정책은 추가하지 않습니다.
    # backend 인증/인가/CSRF 및 실제 관리자 경로의 접근 제한은 별도로 유지합니다.
    # server 범위에 methods-static.conf를 넣으면 POST/PUT/PATCH API도 막히므로 넣지 않습니다.

    # 슬래시 없는 API 주소가 SPA index.html로 빠지지 않게 정규화합니다.
    location = /api { return 308 /api/$is_args$args; }
    location = /storagewiz { return 308 /storagewiz/$is_args$args; }
    location = /process_file { return 308 /process_file/$is_args$args; }

    location /api/ {
        include policies/location/methods-rest.conf; # ON: 일반 REST 메소드 허용
        # 끝에 /가 없으므로 /api/... 경로와 query를 backend에 그대로 전달합니다.
        proxy_pass http://127.0.0.1:9090;
    }
    location /storagewiz/ {
        include policies/location/methods-rest.conf; # ON
        proxy_pass http://127.0.0.1:9080;
    }
    location /process_file/ {
        include policies/location/methods-rest.conf; # ON: 일반 HTTP 요청도 허용
        include policies/location/websocket-origin.conf; # ON: 정확한 origin 검사
        include policies/location/websocket.conf; # ON: Upgrade + 전체 전달 헤더 + WS timeout
        proxy_pass http://127.0.0.1:9090;
    }

    # SPA fallback 대상이 없을 때 내부 redirect 반복 대신 404를 반환합니다.
    location = /index.html {
        include policies/server/methods-static.conf; # ON: 정적 GET/HEAD 제한
        try_files $uri =404;
    }
    location / {
        include policies/server/methods-static.conf; # ON: 정적 파일에만 적용
        try_files $uri $uri/ /index.html;
    }
}
