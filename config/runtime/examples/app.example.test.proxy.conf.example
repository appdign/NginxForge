# Review and copy to conf.d/app.example.test.conf; supply a certificate and fixed backend.
server {
    listen 80;
    server_name app.example.test;
    return 308 https://app.example.test$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name app.example.test;
    ssl_certificate certs/app.example.test/fullchain.pem;
    ssl_certificate_key certs/app.example.test/privkey.pem;
    include snippets/tls.conf;
    include snippets/response-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include snippets/server-guards.conf;
    # Add PUT/PATCH/DELETE only for reviewed application endpoints that need them.
    if ($request_method !~ "^(GET|HEAD|POST|OPTIONS)$") { return 405; }
    location / {
        # Fixed local reverse proxy, never proxy_pass to a client-supplied host/URL.
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Edge profile: overwrite untrusted forwarding headers. For a trusted load balancer,
        # first review the real-IP example and trust only the balancer's precise CIDRs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_intercept_errors on;
        # API clients may need their own error schema; review interception before enabling.
        # For remote backends use HTTPS, proxy_ssl_verify on and a trusted CA bundle.
    }
}
