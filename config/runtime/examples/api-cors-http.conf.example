# Optional HTTP context, included ONCE before API server configuration.
# Replace BOTH lists with exact, reviewed scheme/host/port origins. No wildcard/reflection.
# Include the API's own origin if same-origin browser requests carry an Origin header.
map $http_origin $forge_cors_origin {
    default "";
    "https://portal.example.test" "https://portal.example.test";
    "https://app.example.test" "https://app.example.test";
}
map $http_origin $forge_cors_reject_origin {
    default 1;
    "" 0;
    "https://portal.example.test" 0;
    "https://app.example.test" 0;
}
map $forge_cors_origin $forge_cors_credentials {
    default "true";
    "" "";
}
# Match this list to the API server's actual method policy.
map $http_access_control_request_method $forge_cors_reject_method {
    default 1;
    "" 0;
    GET 0;
    HEAD 0;
    POST 0;
    OPTIONS 0;
}
